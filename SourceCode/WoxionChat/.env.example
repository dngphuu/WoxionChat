# ==============================================================================
# WOXIONCHAT CONFIGURATION ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Dùng cho Django backend (MongoEngine & PyMongo)
# Có thể dùng MongoDB Atlas Cloud: mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/WoxionChat_db?retryWrites=true&w=majority
# Hoặc Local MongoDB: mongodb://127.0.0.1:27017/WoxionChat_db
MONGODB_ATLAS_URI=mongodb://127.0.0.1:27017/WoxionChat_db
MONGODB_ATLAS_DB=WoxionChat_db

# Dùng cho FastAPI agenticRAG service & Document Chunking
# Lưu ý: agenticRAG mặc định truy vấn database tên 'local-bot' (hoặc cùng cluster với URI trên)
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/
MONGO_URI=mongodb://127.0.0.1:27017/
DB_NAME=WoxionChat_db
COLLECTION_NAME=user_feedback

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (Conversation Short-term Memory & Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# ------------------------------------------------------------------------------
# 3. LLM PROXY & LOCAL MODEL CONFIGURATION (Agentic RAG)
# ------------------------------------------------------------------------------
# Cấu hình API OpenAI-compatible LLM Proxy (bắt buộc cho FastAPI run.py)
PROXY_API_KEY=your_proxy_api_key_here
PROXY_BASE_URL=http://171.226.10.154:8080/v1
PROXY_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4

# Cấu hình Local / Self-hosted LLM (vLLM, Ollama, LM Studio - tuỳ chọn)
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=not-needed

# ------------------------------------------------------------------------------
# 4. EXTERNAL AI & EMBEDDING SERVICES
# ------------------------------------------------------------------------------
# Google Gemini API (dùng cho Google GenAI / LangChain Gemini nếu kích hoạt)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=

# Mistral AI (dùng cho OCRfeature - tái cấu trúc layout OCR sang Markdown)
MISTRAL_API_KEY=your_mistral_api_key_here

# HuggingFace Model Download Configuration
# Tắt hf-xet để dùng cơ chế HTTP chuẩn ổn định, tránh lỗi DNS và treo tải mô hình lớn trong WSL
HF_HUB_DISABLE_XET=1
# HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 5. FASTAPI & DJANGO MICROSERVICE NETWORKING
# ------------------------------------------------------------------------------
# Cổng và host cho FastAPI agenticRAG
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=5002
FASTAPI_RELOAD=true

# URL để Django proxy request chat sang FastAPI service
FLASK_SERVICE_URL=http://127.0.0.1:5002

# ------------------------------------------------------------------------------
# 6. SOCIAL AUTHENTICATION (Google OAuth2 - Tuỳ chọn)
# ------------------------------------------------------------------------------
GOOGLE_OAUTH2_CLIENT_ID=your_google_oauth2_client_id
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_oauth2_client_secret

# ------------------------------------------------------------------------------
# 7. ACE STANDALONE EVALUATION / PROVIDERS (Tuỳ chọn nếu chạy module ace độc lập)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key
# SAMBANOVA_API_KEY=your_sambanova_api_key
# TOGETHER_API_KEY=your_together_api_key
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=
# SGLANG_BASE_URL=http://localhost:30000/v1
